@model quanlyhssv.Models.Monhoc

@{
    ViewData["Title"] = "Chi tiết môn học";
}

<div class="row">
    <div class="col-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Thông tin Môn học</h4>
                <p class="card-description">
                    Chi tiết về môn @Model.Tenmon
                </p>

                <form class="forms-sample">
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label font-weight-bold">Mã Môn học:</label>
                        <div class="col-sm-9">
                            <label class="col-form-label">@Model.Mamon</label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label font-weight-bold">Tên Môn học:</label>
                        <div class="col-sm-9">
                            <label class="col-form-label">@Model.Tenmon</label>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-3 col-form-label font-weight-bold">Số lượng giáo viên:</label>
                        <div class="col-sm-9">
                            <label class="badge badge-info">@Model.Giaoviens.Count() giáo viên</label>
                        </div>
                    </div>
                </form>

                <hr />

                <h4 class="card-title mt-4">Danh sách Giáo viên phụ trách</h4>

                @if (Model.Giaoviens != null && Model.Giaoviens.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Mã GV</th>
                                    <th>Họ và Tên</th>
                                    <th>Giới tính</th>
                                    <th>Số điện thoại</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gv in Model.Giaoviens)
                                {
                                    <tr>
                                        <td>@gv.Magv</td>
                                        <td>@gv.Hotengv</td>
                                        <td>@gv.Gioitinh</td>
                                        <td>@gv.Sdt</td>
                                        <td>@gv.Email</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning" role="alert">
                        Chưa có giáo viên nào phụ trách môn học này.
                    </div>
                }

                <div class="mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Mamon" class="btn btn-primary mr-2">
                        <i class="typcn typcn-edit btn-icon-prepend"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-light">
                        Quay lại danh sách
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>