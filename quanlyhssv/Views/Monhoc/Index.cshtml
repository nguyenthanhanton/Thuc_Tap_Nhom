@{
}
@inject quanlyhssv.Models.QuanlyhocsinhThptContext _context

@model IEnumerable<quanlyhssv.Models.Monhoc>

<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">

        <h5 class="mb-2 text-titlecase mb-4">Chuyên môn</h5>

        <a class="btn btn-success btn-sm btn-icon-text mr-3 " asp-action="Create">
            Thêm
            <i class="typcn typcn-edit btn-icon-append  "></i>
        </a>

    </div>

</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="table-responsive pt-3">
                <table class="table table-striped project-orders-table">
                    <thead>
                        <tr>
                            <th class="ml-5">Mã Môn học</th>
                            <th>Tên Môn</th>
                            <th>Số lượng</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Mamon</td>
                                <td>@item.Tenmon</td>

                                <td>@_context.Giaoviens.Count(g => g.Mamon == item.Mamon)</td>
                                <td>
                                    <div class="d-flex align-items-center">

                                        <a asp-controller="Monhoc" asp-route-id="@item.Mamon" asp-action="Details" class="btn btn-info btn-sm btn-icon-text mr-3">
                                            Chi Tiết
                                            <i class="typcn typcn-eye btn-icon-append"></i>
                                        </a>
                                    @if (item.Mamon == "MH0") { }
                                    else
                                    {
                                       
                                            <a asp-controller="Monhoc" asp-route-id="@item.Mamon" asp-action="Edit" class="btn btn-success btn-sm btn-icon-text mr-3">
                                            Sửa
                                            <i class="typcn typcn-edit btn-icon-append"></i>
                                        </a>
                                        <form asp-controller="Monhoc" asp-action="Delete" asp-route-id="@item.Mamon"
                                              method="post" style="display:inline;"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa môn học này không?');">
                                            <button type="submit" class="btn btn-danger btn-sm btn-icon-text">
                                                Xóa
                                                <i class="typcn typcn-delete-outline btn-icon-append"></i>
                                            </button>
                                        </form>
                                   
                                    }
                                        </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<nav aria-label="Page navigation ">
    <ul class="pagination justify-content-center mt-3">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>