@{
}

@model IEnumerable<quanlyhssv.Models.Taikhoan>

<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">
       
        <h5 class="mb-2 text-titlecase mb-4">Tài khoản</h5>
        
        <a  class="btn btn-success btn-sm btn-icon-text mr-3 " asp-action="Create">
            Thêm
            <i class="typcn typcn-edit btn-icon-append  "></i>
        </a>
       
    </div>

    </div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="table-responsive pt-3">
                <table class="table table-striped project-orders-table">
                    <thead>
                        <tr>
                            <th class="ml-5">Mã Tài khoản</th>
                            <th>Tên đăng nhập</th>
                            <th>Họ Tên</th>
                            <th>Quyền hạn</th>
                            <th>Mật khẩu	</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>@item.Matk</td>
								<td>@item.Tendangnhap</td>
								<td>@item.Hoten</td>
								<td>@item.Quyenhan</td>
								<td>@item.Matkhau</td>
								<td>
									<div class="d-flex align-items-center">
                                        <a asp-controller="Taikhoan" asp-route-id="@item.Matk"  asp-action="Edit" class="btn btn-success btn-sm btn-icon-text mr-3">
											Sửa
											<i class="typcn typcn-edit btn-icon-append"></i>
										</a>
                                        <form asp-controller="Taikhoan" asp-action="Delete" asp-route-id="@item.Matk"
                                              method="post" style="display:inline;"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản này không?');">
                                            <button type="submit" class="btn btn-danger btn-sm btn-icon-text">
                                                Xóa
                                                <i class="typcn typcn-delete-outline btn-icon-append"></i>
                                            </button>
                                        </form>
									</div>
								</td>
							</tr>
						}   
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<nav aria-label="Page navigation ">
    <ul class="pagination justify-content-center mt-3">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>