@using quanlyhssv.Models.ViewsModel;
@model DashboardViewModel

<div class="row align-items-stretch">
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="mb-0 text-muted font-weight-bold">TỔNG HỌC SINH</p>
                    <label class="badge badge-success">Toàn trường</label>
                </div>
                <h3 class="font-weight-bold mb-3">@Model.TongHocSinh</h3>
                <div class="mt-auto" style="height: 180px;">
                    <canvas id="student-chart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 grid-margin stretch-card">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <p class="mb-3 text-muted font-weight-bold text-uppercase">Cơ cấu nhân sự</p>
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <p class="mb-1 text-muted small">Lớp học</p>
                        <h5 class="mb-0 font-weight-bold">@Model.TongLop</h5>
                    </div>
                    <div class="text-right">
                        <p class="mb-1 text-muted small">Giáo viên</p>
                        <h5 class="mb-0 font-weight-bold">@Model.TongGiaoVien</h5>
                    </div>
                </div>
                <div class="mt-auto" style="height: 180px;">
                    <canvas id="class-teacher-chart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 grid-margin stretch-card">
        <div class="card h-100">
            <div class="card-body d-flex flex-column">
                <p class="mb-3 text-muted font-weight-bold text-uppercase">Tăng trưởng số lượng</p>
                <p class="mb-2 small">Quy mô hiện tại: <span class="font-weight-bold">@Model.TongHocSinh</span></p>
                <div class="mt-auto" style="height: 180px;">
                    <canvas id="growth-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="mb-0 text-titlecase">Chi tiết theo năm học</h5>
            <a asp-controller="Namhoc" asp-action="Create" class="btn btn-success btn-sm btn-icon-text">
                Thêm năm học mới <i class="typcn typcn-plus btn-icon-append"></i>
            </a>
        </div>
        <div class="card">
            <div class="table-responsive pt-3">
                <table class="table table-striped project-orders-table">
                    <thead>
                        <tr>
                            <th>Năm học</th>
                            <th>Số lượng lớp</th>
                            <th>Số lượng học sinh</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ThongKeTheoNam)
                        {
                            <tr>
                                <td class="font-weight-bold">@item.TenNamHoc</td>
                                <td>@item.SoLop lớp</td>
                                <td>@item.SoHocSinh học sinh</td>
                                <td>
                                    <label class="badge @(item == Model.ThongKeTheoNam.Last() ? "badge-success" : "badge-secondary")">
                                        @(item == Model.ThongKeTheoNam.Last() ? "Hiện tại" : "Lưu trữ")
                                    </label>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <a asp-controller="Lophoc" asp-action="Index" asp-route-Manh="@item.Manh" class="btn btn-info btn-sm mr-2 text-white">Xem lớp</a>
                                        <a asp-controller="Namhoc" asp-action="Edit" asp-route-id="@item.Manh" class="btn btn-primary btn-sm mr-2">Sửa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chartColors = {
                purple: '#7978E9',
                blue: '#248AFD',
                teal: '#71C1E4',
                grid: 'rgba(0,0,0,0.03)'
            };

   
                const commonScales = {
            x: {
                grid: { display: false },
                ticks: {
                    maxRotation: 45,
                    minRotation: 0,
                    font: { size: 10 }
                }
            },
            y: {
                beginAtZero: true,
                grid: { color: chartColors.grid },
                ticks: {
                    font: { size: 10 },
                
                    stepSize: 1,         
                    precision: 0,        
                    callback: function(value) {
                        if (Math.floor(value) === value) {
                            return value; 
                        }
                    }
                
                }
            }
        };

          
            new Chart(document.getElementById("student-chart"), {
                type: 'line',
                data: {
                    labels: [@foreach (var item in Model.ThongKeTheoNam) { <text>'@item.TenNamHoc',</text> }],
                    datasets: [{
                        label: 'Học sinh',
                        data: [@foreach (var item in Model.ThongKeTheoNam) { <text>@item.SoHocSinh,</text> }],
                        borderColor: chartColors.purple,
                        backgroundColor: 'rgba(121, 120, 233, 0.1)',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: commonScales
                }
            });


            new Chart(document.getElementById("class-teacher-chart"), {
                type: 'bar',
                data: {
                    labels: ['Lớp', 'Giáo viên'],
                    datasets: [{
                        label: 'Số lượng',
                        data: [@Model.TongLop, @Model.TongGiaoVien],
                        backgroundColor: [chartColors.blue, chartColors.teal],
                        borderRadius: 5
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: commonScales
                }
            });

    
            const growthCtx = document.getElementById("growth-chart").getContext('2d');
            const gradient = growthCtx.createLinearGradient(0, 0, 0, 180);
            gradient.addColorStop(0, 'rgba(36, 138, 253, 0.3)');
            gradient.addColorStop(1, 'rgba(36, 138, 253, 0.0)');

            new Chart(growthCtx, {
                type: 'line',
                data: {
                    labels: [@foreach (var item in Model.ThongKeTheoNam) { <text>'@item.TenNamHoc',</text> }],
                    datasets: [{
                        label: 'Số học sinh',
                        data: [@foreach (var item in Model.ThongKeTheoNam) { <text>@item.SoHocSinh,</text> }],
                        borderColor: chartColors.blue,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: commonScales
                }
            });
        });
    </script>
}