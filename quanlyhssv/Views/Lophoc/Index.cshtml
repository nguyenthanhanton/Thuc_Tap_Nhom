

@model IEnumerable<quanlyhssv.Models.Lop>

@inject quanlyhssv.Models.QuanlyhocsinhThptContext _context
@{


}
<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">
        <h5 class="mb-2 text-titlecase mb-4">Lớp học</h5>

        <a asp-action="Create" class="btn btn-success btn-sm btn-icon-text mr-3 ">
            Thêm
            <i class="typcn typcn-edit btn-icon-append  "></i>
        </a>

    </div>

</div>
<form asp-action="Index" method="get" id="filterForm">
    <div class="form-group">
        <label>Năm học</label>
        <select name="Manh" class="form-control" onchange="document.getElementById('filterForm').submit();">
            <option value="0">-- Tất cả --</option>
            @foreach (var m in _context.Namhocs.ToList())
            {
                <option value="@m.Manh" selected="@(m.Manh == ViewBag.SelectedYear)">
                    @m.Ten
                </option>
            }
        </select>
    </div>
</form>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="table-responsive pt-3">
                <table class="table table-striped project-orders-table">
                    <thead>
                        <tr>
                            <th class="ml-5">Mã lớp</th>
                            <th>Tên lớp</th>
                            <th>Khối</th>
                            <th>Giáo viên phụ trách</th>
                            <th>Số lượng học sinh</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)

                        {  <tr>
                                <td>@item.Malop</td>
                                <td>@item.Tenlop</td>
                                <td>@item.Khoi</td>

                                @if (@_context.Giaoviens.Where(g => g.Magv == item.Magv).FirstOrDefault() == null)
                                {
                                    <td>không có</td>
                                }
                                else
                                {
                                    <td> @_context.Giaoviens.Where(g => g.Magv == item.Magv).FirstOrDefault().Hotengv - @item.Magv</td>
                                }
                                <td>@_context.Hocsinhs.Count(g =>g.Malop==item.Malop)</td>
                                
                                
                                <td>
                                    <div class="d-flex align-items-center">
                                        <a asp-controller="Lophoc" asp-route-id="@item.Malop" asp-action="Details" class="btn btn-success btn-sm btn-icon-text mr-3">
                                            Chi Tiết
                                            <i class="typcn typcn-edit btn-icon-append"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Malop" class="btn btn-success btn-sm btn-icon-text mr-3">
                                            Sửa
                                            <i class="typcn typcn-edit btn-icon-append"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Malop"
                                              method="post" style="display:inline;"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp này không?');">
                                            <button type="submit" class="btn btn-danger btn-sm btn-icon-text">
                                                Xóa
                                                <i class="typcn typcn-delete-outline btn-icon-append"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center mt-3">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-Manh="@ViewBag.SelectedYear">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>
