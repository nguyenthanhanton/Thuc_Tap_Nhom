@model quanlyhssv.Models.Lop

@{
    ViewData["Title"] = "Chi tiết lớp học";
    var hockies = ViewBag.Hockies as List<quanlyhssv.Models.Hocky>;
    var dsHocSinh = Model.Hocsinhs.OrderBy(h => h.Hotenhs).ToList();
}

<div class="content-wrapper">
    @* --- PHẦN THÔNG BÁO --- *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @* --- THÔNG TIN LỚP HỌC --- *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-gradient-primary text-white shadow-sm">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h3 class="font-weight-bold mb-1">Lớp: @Model.Tenlop</h3>
                        <p class="mb-0">Mã: @Model.Malop | Khối: @Model.Khoi | Năm học: @Model.Manh</p>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm">Quay lại</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @* --- CỘT PHÂN CÔNG GIẢNG DẠY --- *@
        <div class="col-lg-7 grid-margin stretch-card">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="card-title mb-0">Phân công giảng dạy</h4>
                        <a asp-action="AssignSubject" asp-route-malop="@Model.Malop" class="btn btn-info btn-sm text-white">
                            Thêm môn học
                        </a>
                    </div>

                    @if (hockies != null && hockies.Any())
                    {
                        <ul class="nav nav-tabs custom-tabs" role="tablist">
                            @for (int i = 0; i < hockies.Count; i++)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(i == 0 ? "active" : "")" data-toggle="tab" href="#content-@hockies[i].Mahk">
                                        @hockies[i].Ten
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="tab-content border p-3">
                            @for (int i = 0; i < hockies.Count; i++)
                            {
                                var hkId = hockies[i].Mahk;
                                // So sánh mã học kỳ (dùng ToUpper và Trim để tránh lệch ký tự trắng)
                                var dsMonTheoHK = Model.Giangdays
                                .Where(g => g.Mahk.Trim().ToUpper() == hkId.Trim().ToUpper())
                                .ToList();

                                <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="content-@hkId">
                                    @* Dòng Debug (Xóa sau khi chạy thành công) *@
                                    <small class="text-muted">Đang lọc mã HK: <b>@hkId</b> - Tìm thấy: @dsMonTheoHK.Count môn</small>

                                    <table class="table table-hover mt-2">
                                        <thead>
                                            <tr class="bg-light">
                                                <th>Môn học</th>
                                                <th>Giáo viên</th>
                                                <th class="text-center">Thao tác</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (dsMonTheoHK.Any())
                                            {
                                                foreach (var gd in dsMonTheoHK)
                                                {
                                                    <tr>
                                                        <td><b>@gd.MamonNavigation?.Tenmon</b> <br /><small>@gd.Mamon</small></td>
                                                        <td><span class="badge badge-outline-info">@gd.MagvNavigation?.Hotengv</span></td>
                                                        <td class="text-center">
                                                            <a asp-controller="Lophoc" asp-action="nhapdiem"
                                                               asp-route-malop="@Model.Malop" asp-route-mamon="@gd.Mamon" asp-route-mahk="@hkId"
                                                               class="btn btn-success btn-xs">Điểm</a>

                                                            <form asp-action="xoamonhoc" method="post" style="display:inline;"
                                                                  onsubmit="return confirm('Xóa môn học này?');">
                                                                <input type="hidden" name="malop" value="@Model.Malop" />
                                                                <input type="hidden" name="mamon" value="@gd.Mamon" />
                                                                <input type="hidden" name="mahk" value="@hkId" />
                                                                <button type="submit" class="btn btn-danger btn-xs">Xóa</button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="3" class="text-center py-4 text-muted">Không có dữ liệu môn học cho học kỳ này.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* --- CỘT DANH SÁCH HỌC SINH --- *@
        <div class="col-lg-5 grid-margin stretch-card">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title">Học sinh (@dsHocSinh.Count)</h4>
                    <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr><th>Mã HS</th><th>Họ Tên</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var hs in dsHocSinh)
                                {
                                    <tr><td>@hs.Mahs</td><td>@hs.Hotenhs</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(to right, #4747ff, #8383ff);
    }

    .custom-tabs .nav-link.active {
        color: #4747ff;
        border-bottom: 3px solid #4747ff;
        font-weight: bold;
    }

    .btn-xs {
        padding: 4px 8px;
        font-size: 0.75rem;
        border-radius: 3px;
    }

    .tab-content {
        background: #fff;
        border-top: none !important;
    }
</style>