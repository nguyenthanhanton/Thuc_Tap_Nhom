@model IEnumerable<quanlyhssv.Models.Lop>

@inject quanlyhssv.Models.QuanlyhocsinhThptContext _context
@{


}

<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">
        <h5 class="mb-2 text-titlecase mb-4">Phụ trách</h5>
    </div>

</div>
<form asp-action="phutrach" method="get" id="filterForm">
    <div class="form-group">
        <label>Năm học</label>
        <select name="Manh" class="form-control" onchange="document.getElementById('filterForm').submit();">
            <option value="0">-- Tất cả --</option>
            @foreach (var m in _context.Namhocs.ToList())
            {
                <option value="@m.Manh" selected="@(m.Manh == ViewBag.SelectedYear)">
                    @m.Ten
                </option>
            }
        </select>
    </div>
</form>
<div class="row">
    <div class="col-md-12">
        <form action="phutrach" method="post" style="display:inline;"
              onsubmit="return confirm('Bạn có chắc chắn muốn muốn thay đổi giáo viên phụ trách hay không?');">
   
            <div class="form-group text-right">
                <input type="submit" value="Lưu" class="btn btn-success btn-sm btn-icon-text" />
            </div>
            <div class="card">
                <div class="table-responsive pt-3">
                    <table class="table table-striped project-orders-table">
                        <thead>
                            <tr>
                                <th class="ml-5">Mã lớp</th>
                                <th>Tên lớp</th>
                                <th>Khối</th>
                                <th>Năm học</th>
                                <th>Giáo viên phụ trách</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Malop</td>
                                    <td>@item.Tenlop</td>
                                    <td>@item.Khoi</td>
                                    <td>@_context.Namhocs.Where(n => n.Manh == item.Manh).FirstOrDefault().Ten</td>
                                    <td>
                                        <!-- Cách 2: Sử dụng tên theo mã lớp -->
                                        <select name="magv_@item.Malop" class="form-control">
                                            <option value="">Không</option>
                                            @foreach (var gv in _context.Giaoviens.ToList())
                                            {
                                                <option value="@gv.Magv" selected="@(gv.Magv == item.Magv)">
													@gv.Hotengv - @gv.Magv
                                                </option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </div>
</div>
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center mt-3">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-Manh="@ViewBag.SelectedYear">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>
