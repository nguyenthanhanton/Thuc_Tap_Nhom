@model quanlyhssv.Models.Namhoc

@{
    ViewData["Title"] = "Create";
}


<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">
        <h5 class="mb-2 text-titlecase mb-4">Tạo Năm học</h5>

    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Manh" class="control-label">Mã năm học</label>
                <input asp-for="Manh" readonly class="form-control" />
                <span asp-validation-for="Manh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ten" class="control-label"> Tên</label>
                <input asp-for="Ten" class="form-control" />
                <span asp-validation-for="Ten" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Tạo" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" asp-controller="home">Trở về</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
