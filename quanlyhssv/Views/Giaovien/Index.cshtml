@{
}

@model IEnumerable<quanlyhssv.Models.Giaovien>
@inject quanlyhssv.Models.QuanlyhocsinhThptContext _context
<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">
        <h5 class="mb-2 text-titlecase mb-4">Giáo viên</h5>

        <a asp-action="Create" class="btn btn-success btn-sm btn-icon-text mr-3 ">
            Thêm
            <i class="typcn typcn-edit btn-icon-append  "></i>
        </a>
        
    </div>

</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="table-responsive pt-3">
                <table class="table table-striped project-orders-table">
                    <thead>
                        <tr>
                            <th class="ml-5">Mã giáo viên</th>
                            <th>Họ tên</th>
                            <th>Giới tính</th>
                            <th>Ngày sinh</th>
                            <th>Gmail</th>
                            <th>Số điện thoại</th>
                             <th>Chuyên môn</th> 
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Magv</td>
                                <td>@item.Hotengv</td>
                                <td>@item.Gioitinh</td>
                                <td>@item.Ngaysinh</td>
                                <td>@item.Email</td>
                                <td>@item.Sdt</td>
                                @if(item.Mamon== "MH0"){ <td></td>}
                                else
                                {
                                    <td>@_context.Monhocs.FirstOrDefault(m => m.Mamon == item.Mamon)?.Tenmon </td>
                                }
                                <td>
                                    <div class="d-flex align-items-center">
                                        <a asp-action="Edit" asp-route-id="@item.Magv" class="btn btn-success btn-sm btn-icon-text mr-3">
                                            Sửa
                                            <i class="typcn typcn-edit btn-icon-append"></i>
                                        </a>
                                        @* <form asp-controller="Giaovien" asp-action="Delete" asp-route-id="@item.Magv" *@
                                        @*       method="post" style="display:inline;" *@
                                        @*       onsubmit="return confirm('Bạn có chắc chắn muốn xóa giáo viên này không?');"> *@
                                        @*     <button type="submit" class="btn btn-danger btn-sm btn-icon-text"> *@
                                        @*         Xóa *@
                                        @*         <i class="typcn typcn-delete-outline btn-icon-append"></i> *@
                                        @*     </button> *@
                                        @* </form> *@
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<nav aria-label="Page navigation ">
    <ul class="pagination justify-content-center mt-3">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
    </ul>
</nav>