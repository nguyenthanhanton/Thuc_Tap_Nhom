@model quanlyhssv.Models.Giaovien

@{
    ViewData["Title"] = "Edit";
}
@inject quanlyhssv.Models.QuanlyhocsinhThptContext _context

<div class="row">
    <div class="col-xl-12 grid-margin stretch-card justify-content-between  ">
        <h5 class="mb-2 text-titlecase mb-4">Sữa giáo viên</h5>

    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Magv" class="control-label">Mã giáo viên</label>
                <input asp-for="Magv" readonly class="form-control" />
                <span asp-validation-for="Magv" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Hotengv" class="control-label">Họ tên</label>
                <input asp-for="Hotengv" class="form-control" />
                <span asp-validation-for="Hotengv" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ngaysinh" class="control-label">Ngày sinh</label>
                <input asp-for="Ngaysinh" type="date" class="form-control" />
                <span asp-validation-for="Ngaysinh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gioitinh" class="control-label">Giới tính</label>
                <select asp-for="Gioitinh" class="form-control">
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                </select>
                <span asp-validation-for="Gioitinh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Sdt" class="control-label">Số điện thoại</label>
                <input asp-for="Sdt" type="number" class="form-control" />
                <span asp-validation-for="Sdt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Mamon" class="control-label">Chuyên môn</label>
                <select asp-for="Mamon" class="form-control">
                    @foreach (var m in _context.Monhocs.ToList())
                    {
                        <option value="@m.Mamon">@m.Tenmon</option>
                    }
                </select>
                <span asp-validation-for="Mamon" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sữa" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Trở về</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
